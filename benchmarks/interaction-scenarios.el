(defun etaf-ncm-benchmark-inventory ()
  "Return the full interaction inventory, including all nine library buttons."
  (append etaf-ncm-benchmark-actions
          (cl-loop for section in '(:playlists :albums :artists :charts :podcasts :recent)
                   collect (list :id (format "resource.%s.play" (substring (symbol-name section) 1))
                                 :library section :help "播放这一行" :ordinal 0 :setup 'home :op :play))
          (cl-loop for section in '(:daily :fm :liked :playlists :albums :artists :charts :podcasts :recent)
                   for label in '("每日推荐" "私人 FM" "我喜欢的音乐" "我的歌单" "收藏专辑" "收藏歌手" "排行榜" "播客" "最近播放")
                   for i from 1
                   append (list (list :id (format "library.%s.button" (substring (symbol-name section) 1)) :help label :section section)
                                (list :id (format "library.%s.key" (substring (symbol-name section) 1)) :key (number-to-string i) :section section)))))

(defun etaf-ncm-benchmark-target (runtime action)
  "Find ACTION's visible control in RUNTIME or signal an error."
  (or (plist-get action :ref)
      (plist-get action :slider)
      (let ((matches (seq-filter
                      (lambda (entry)
                        (let ((help (plist-get (cdr entry) :help-echo)))
                          (when (functionp help) (setq help (funcall help (selected-window) (current-buffer) (point))))
                          (and (plist-get (cdr entry) :on-press)
                               (or (plist-get action :aria) (stringp help))
                               (cond ((plist-get action :aria)
                                      (equal (plist-get action :aria) (plist-get (cdr entry) :aria-label)))
                                     ((plist-get action :help-prefix)
                                      (string-prefix-p (plist-get action :help-prefix) help))
                                     (t (equal help (plist-get action :help))))
                               (etaf-host-ref-bounds runtime (car entry)))))
                      (etaf-runtime-host-props-entries runtime))))
        (setq matches (sort matches (lambda (a b) (< (car (etaf-host-ref-bounds runtime (car a)))
                                                     (car (etaf-host-ref-bounds runtime (car b)))))))
        (or (car (nth (or (plist-get action :ordinal) 0) matches))
            (error "Missing visible target for %s" (plist-get action :id))))))

(defun etaf-ncm-benchmark-gesture (runtime ref phase ratio)
  "Send a measured native pointer payload to REF using its painted bounds."
  (let* ((window (selected-window)) (bounds (etaf-host-ref-bounds runtime ref))
         (xy (and bounds (posn-x-y (posn-at-point (car bounds) window))))
         (width (and bounds (car (window-text-pixel-size window (car bounds) (cdr bounds))))))
    (unless (and xy width (> width 0)) (error "Unpainted slider %S" ref))
    (etaf-dispatch-event runtime ref (if (eq phase 'press) 'press 'drag)
                        (list :phase phase :host-ref ref :window window :buffer (current-buffer)
                              :position (cons (+ (car xy) (* ratio width)) (cdr xy))) t)))

(defun etaf-ncm-benchmark-input (runtime action ref ratio)
  "Execute ACTION via the GUI command loop or native pointer event boundary."
  (let ((etaf-ncm-buffer-name (buffer-name (current-buffer))))
  (cond
   ((plist-get action :slider)
    (etaf-ncm-benchmark-gesture runtime ref (plist-get action :gesture) ratio))
   ((plist-get action :wheel)
    (let* ((window (selected-window))
           (x (if (plist-get action :queue-scroll) (- (window-body-width window t) 20)
                (/ (window-body-width window t) 2)))
           (position (posn-at-x-y x (* 10 (window-font-height window)) window))
           (event (list (if (eq (plist-get action :wheel) 'down) 'wheel-down 'wheel-up) position)))
      (execute-kbd-macro (vector event))))
   ((plist-get action :text)
    (execute-kbd-macro (vconcat (kbd (or (plist-get action :key) "RET"))
                               (string-to-vector (plist-get action :text)) (kbd "RET"))))
   ((plist-get action :cancel)
    (condition-case nil
        (execute-kbd-macro (vconcat (kbd (plist-get action :key)) (kbd "C-g")))
      (quit nil)))
   ((plist-get action :key) (execute-kbd-macro (kbd (plist-get action :key))))
   (t (execute-kbd-macro (kbd "RET"))
      (when (plist-get action :double) (execute-kbd-macro (kbd "RET")))))
  ;; A sample that leaves a prompt open would poison every later sample in
  ;; this shared GUI instance; the sample itself still fails verification.
  (when-let* ((prompt (active-minibuffer-window)))
    (condition-case nil
        (with-selected-window prompt (keyboard-quit))
      (t nil)))
  (when (buffer-live-p (etaf-runtime-buffer runtime)) (etaf-runtime-flush runtime))
  (redisplay t)))

(defun etaf-ncm-benchmark-agrees (app backend op)
  "Check the displayed authoritative result after OP's reply, not just receipt."
  (let* ((state (etaf-ncm-state app)) (status (plist-get state :status))
         (queue (plist-get backend :queue))
         (id (plist-get (nth (1- (plist-get backend :pos)) queue) :id)))
    (pcase op
      (:volume (= (plist-get status :volume) (plist-get backend :volume)))
      ((or :play :next :previous :jump) (equal (plist-get status :song-id) id))
      ((or :toggle :stop) (eq (plist-get status :state) (intern (plist-get backend :state))))
      ((or :seek :status) (< (abs (- (plist-get status :elapsed) (plist-get backend :elapsed))) 1.1))
      (:shuffle (eq (and (plist-get status :shuffle) t) (and (plist-get backend :shuffle) t)))
      (:repeat (eq (and (plist-get status :repeat) t) (and (plist-get backend :repeat) t)))
      ((or :like :unlike :like-toggle)
       (eq (and (plist-get status :liked) t) (and (memq id (plist-get backend :likes)) t)))
      (:add (= (plist-get (plist-get state :queue) :count) (length queue)))
      (:download (and (plist-get state :downloads) t))
      (:search (= (plist-get state :rows-total) 17))
      (_ t))))

(defun etaf-ncm-benchmark-action-setup (action layout reply-p _mode)
  "Mount a stateful fixture for ACTION in LAYOUT; REPLY-P times completion."
  (let* ((etaf-ncm-status-interval 3600)
         (etaf-ncm-prefetch-libraries nil)
         (etaf-ncm-buffer-name " *ncm-interaction-benchmark*")
         (display-buffer-overriding-action '((display-buffer-same-window)))
         (backend (etaf-ncm-benchmark-backend))
         (app (etaf-ncm-create :client (plist-get backend :client)))
         (op (plist-get action :op))
         (ops (if (eq op :like-toggle) '(:like :unlike) (and op (list op))))
         ;; A song-changing reply also asks for the lyric and the queue.  Those
         ;; follow-up replies arrive after the measured status application in
         ;; real use, so the reply scenario holds them too; the panel updates
         ;; have their own scenarios.
         (held (if (and reply-p (memq op '(:play :next :previous :jump)))
                   (append ops '(:lyric :queue))
                 ops))
         buffer runtime ref before focus-before ratio (n 0))
    (set-frame-size nil (cadr layout) (caddr layout))
    (delete-other-windows)
    (when (plist-get action :pre-downloaded)
      ;; The first liked row is already on disk: the measured press is a
      ;; re-download, and the row must paint its checked state before it.
      (setf (plist-get backend :downloads)
            (list (list :id 1 :name "离线验证" :artist "演示"
                        :file "/offline-fixture/not-an-actual-file.flac"
                        :level "lossless" :br 900000 :bytes 1000))))
    ;; Populate the data cache before mounting, not by repeatedly repainting
    ;; nine pages during setup. The measured first GUI action is still cold.
    (dolist (section '(:daily :fm :liked :playlists :albums :artists :charts :podcasts :recent))
      (etaf-ncm-locate app section))
    (etaf-ncm-locate app (or (plist-get action :library)
                            (if (string-match-p "\\`\\(?:select\\|page\\|list\\|row\\)\\." (plist-get action :id)) :liked :daily)))
    (setq buffer (etaf-ncm-open app) runtime (etaf-runtime-for-buffer buffer))
    (etaf-runtime-flush runtime)
    (list
     :buffer buffer :disposes-buffer (plist-get action :closed) :ready (lambda () t)
     :environment (lambda () (list :network :false :layout (symbol-name (car layout)) :action (plist-get action :id)
                                  :phase (if reply-p "reply" "input") :cached-libraries 9 :songs 180
                                  :input-path (cond ((plist-get action :slider) "pointer-dispatch")
                                                    ((plist-get action :wheel) "command-loop-wheel")
                                                    ((plist-get action :key) "command-loop-key")
                                                    (t "focus-return"))))
     :prepare
     (lambda ()
       (cl-incf n)
       (setq ratio (if (cl-oddp n) 0.8 0.2))
       (setf (plist-get backend :hold) nil)
       (etaf-ncm-benchmark-deliver backend)
       (with-current-buffer buffer
         ;; Samples press the same row back-to-back; the player's one-second
         ;; double-press window would turn the next sample's first press into
         ;; a play.  Reset the gesture memory with the rest of the setup.
         (plist-put app :last-press nil)
         (when-let* ((section (plist-get action :section)))
           (etaf-ncm-locate app (if (eq section :daily) :fm :daily)))
         (pcase (plist-get action :setup)
           ('home (execute-kbd-macro (kbd "<home>")))
           ('end (execute-kbd-macro (kbd "<end>")))
           ('list (etaf-ncm-show-pane app 'list))
           ('lyrics (etaf-ncm-show-pane app 'list))
           ((or 'queue 'queue-scrolled)
            (etaf-ncm-show-pane app 'list)
            (etaf-focus runtime 'ncm-queue-aside) (execute-kbd-macro (kbd "RET"))))
         (when (eq (plist-get action :setup) 'lyrics)
           (etaf-focus runtime 'ncm-lyrics) (execute-kbd-macro (kbd "RET")))
         (when (eq (plist-get action :setup) 'queue-scrolled)
           (etaf-ncm-benchmark-input runtime (list :wheel 'down :queue-scroll t) nil nil))
         (when (memq op '(:volume :stop :like :unlike))
           (pcase op
             (:volume (etaf-ncm-set-volume app 50))
             (:stop (setf (plist-get backend :state) "playing") (etaf-ncm-refresh app))
             (:like (etaf-ncm-like app t))
             (:unlike (etaf-ncm-like app))))
         (etaf-runtime-flush runtime)
         (setq ref (and (not (or (plist-get action :key) (plist-get action :wheel)))
                        (etaf-ncm-benchmark-target runtime action)))
         (when (and ref (not (plist-get action :slider))) (etaf-focus runtime ref))
         (when (memq (plist-get action :gesture) '(move end cancel))
           (etaf-ncm-benchmark-gesture runtime ref 'start (- 1 ratio)))
         (etaf-runtime-flush runtime)
         (when (plist-get action :background)
           (setf (plist-get backend :elapsed) 42)
           (etaf-ncm-refresh app)
           (pcase (plist-get action :background)
             ('inline (setf (plist-get backend :elapsed) 42.25))
             ('line (setf (plist-get backend :elapsed) 46))
             ('list (let ((songs (plist-get backend :songs)))
                      (setf (plist-get backend :songs)
                            (cons (plist-put (copy-sequence (car songs)) :name (format "更新的曲目 %d" n)) (cdr songs)))))))
         (redisplay t)
         (setq before (etaf-ncm-state app) focus-before (etaf-focused-host-ref runtime))
         (setf (plist-get backend :requests) nil (plist-get backend :hold) held)
         (when reply-p
           (etaf-ncm-benchmark-input runtime action ref ratio)
           (unless (plist-get backend :pending) (error "No reply queued for %s" (plist-get action :id))))))
     :invoke
     (lambda (_sample)
       (with-current-buffer buffer
         (if reply-p
             (progn (etaf-ncm-benchmark-deliver backend) (etaf-runtime-flush runtime) (redisplay t))
           (etaf-ncm-benchmark-input runtime action ref ratio))))
     :verify
     (lambda ()
       (if (plist-get action :closed) (not (buffer-live-p buffer))
         (let* ((after (etaf-ncm-state app)) (sel (plist-get after :selection))
                (old (plist-get before :selection)) (size (plist-get after :page-size))
                (last (1- (plist-get after :rows-total))))
           (and (not (plist-get after :error))
                (or (not ops) (seq-some (lambda (r) (memq (plist-get r :op) ops)) (plist-get backend :requests)))
                (or (not (plist-get action :section)) (eq (plist-get action :section) (plist-get after :section)))
                (or (not (plist-get action :aside)) (eq (plist-get action :aside) (plist-get after :aside)))
                (or (not (plist-get action :pane)) (eq (plist-get action :pane) (plist-get after :pane)))
                (or (not (plist-get action :focus)) (not (equal focus-before (etaf-focused-host-ref runtime))))
                (or (not (plist-get action :theme)) (not (equal (plist-get before :theme) (plist-get after :theme))))
                (pcase (plist-get action :selection)
                  ('delta-down (= sel (min last (1+ old)))) ('delta-up (= sel (max 0 (1- old))))
                  ('next-page (= sel (min last (+ old size)))) ('previous-page (= sel (max 0 (- old size))))
                  ('first (= sel 0)) ('last (= sel last)) ('third (= sel 2)) (_ t))
                ;; A library wheel moves the row window and leaves the
                ;; selection where it was.
                (pcase (plist-get action :window-scroll)
                  ('delta-down (= (plist-get after :window-start)
                                  (min (max 0 (- (plist-get after :rows-total) size))
                                       (1+ (plist-get before :window-start)))))
                  ('delta-up (= (plist-get after :window-start)
                                (max 0 (1- (plist-get before :window-start)))))
                  (_ t))
                (pcase (plist-get action :background)
                  ('line (not (equal (plist-get before :lyric-line) (plist-get after :lyric-line))))
                  ('inline (equal (plist-get before :lyric-line) (plist-get after :lyric-line)))
                  ('list (equal (plist-get (car (plist-get after :items)) :name)
                                (plist-get (car (plist-get backend :songs)) :name)))
                  (_ t))
                (or (not (plist-get action :queue-scroll)) (not (= (plist-get before :queue-start) (plist-get after :queue-start))))
                (or (not reply-p) (and (etaf-ncm-benchmark-agrees app backend op)
                                      ;; Only follow-up reads may remain pending
                                      ;; after the primary reply is applied.
                                      (cl-every (lambda (entry)
                                                  (memq (car entry) '(:lyric :queue :status)))
                                                (plist-get backend :pending))))))))
     :observe
     (lambda (sink)
       (etaf-performance-start runtime)
       (let ((name (buffer-name buffer))
             (before (mapcar (lambda (op) (cons (plist-get op :runtime-id) (plist-get op :id)))
                            (plist-get (etaf-performance-report-data) :operations))))
         (lambda ()
           (etaf-performance-stop runtime)
           (dolist (op (plist-get (etaf-performance-report-data) :operations))
             (when (and (equal (plist-get op :buffer-name) name)
                        (not (member (cons (plist-get op :runtime-id) (plist-get op :id)) before)))
               (dolist (stage (plist-get op :stages))
                 (funcall sink (append (list :provider (plist-get stage :provider)
                                             :stage (plist-get stage :stage)
                                             :duration-ms (plist-get stage :duration-ms))
                                       (plist-get stage :metadata)))))))))
     :outcome (lambda () (list :action (plist-get action :id) :phase (if reply-p "reply" "input")))
     :cleanup (lambda () (when (buffer-live-p buffer)
                           (let ((etaf-ncm-buffer-name (buffer-name buffer)))
                             (with-current-buffer buffer (etaf-ncm-close))))))))

(dolist (layout etaf-ncm-benchmark-layouts)
  (dolist (action (etaf-ncm-benchmark-inventory))
    (when (or (not (plist-get action :layouts)) (memq (car layout) (plist-get action :layouts)))
      (dolist (phase (cond ((plist-get action :background) '(reply))
                          ((plist-get action :op) '(input reply)) (t '(input))))
        (let ((case-action action) (case-layout layout) (reply-p (eq phase 'reply)))
          (taf-benchmark-register
           (format "ncm.%s.%s.%s" (car layout) (plist-get action :id) phase)
           :version 2 :modes '(gui) :isolation (if (plist-get action :closed) 'fresh 'series)
           :required-providers '(etaf) :budget-ms 100 :impact 'local
           :description (format "Native %s, %s phase, %s layout; zero network wait" (plist-get action :id) phase (car layout))
           :setup (lambda (mode) (etaf-ncm-benchmark-action-setup case-action case-layout reply-p mode))))))))

