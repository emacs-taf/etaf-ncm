;;; interaction-scenarios.el --- Native NCM interaction inventory -*- lexical-binding: t; -*-

;;; Commentary:
;; Loaded by performance-scenarios.el. Each entry is a named native GUI input
;; or asynchronous reply, not an app-model microbenchmark. Setup/control lookup
;; is outside timing; activation, publication and redisplay are inside it.
;; Stateful offline replies prevent external account/player/file mutations.

;;; Code:
(require 'etaf-ncm)
(load (expand-file-name "interaction-fixture.el" (file-name-directory (or load-file-name buffer-file-name))) nil t)
(declare-function taf-benchmark-register "performance-driver" (id &rest properties))

